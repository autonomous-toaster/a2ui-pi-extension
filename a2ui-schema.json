{
  "version": "v0.9",
  "description": "A2UI v0.9 schema with Phase 1 + Phase 2A components",
  "components": {
    "Text": {
      "description": "Display text content",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Text"},
        "text": {"type": "string"},
        "attributes": {
          "type": "object",
          "properties": {
            "textAlignment": {"enum": ["start", "center", "end"]},
            "style": {"type": "string"}
          }
        }
      },
      "required": ["id", "component", "text"]
    },
    "Button": {
      "description": "Clickable button with optional action",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Button"},
        "child": {"type": "string"},
        "action": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "context": {"type": "object"}
          }
        },
        "attributes": {
          "type": "object",
          "properties": {
            "primary": {"type": "boolean"},
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component"]
    },
    "TextField": {
      "description": "Text input field",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "TextField"},
        "label": {"type": "string"},
        "value": {"type": "string"},
        "placeholder": {"type": "string"},
        "attributes": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component"]
    },
    "Checkbox": {
      "description": "Boolean toggle checkbox",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Checkbox"},
        "label": {"type": "string"},
        "checked": {"type": "boolean"},
        "attributes": {
          "type": "object",
          "properties": {
            "required": {"type": "boolean"},
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component", "label"]
    },
    "RadioGroup": {
      "description": "Radio button group for single selection",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "RadioGroup"},
        "label": {"type": "string"},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "value": {"type": "string"}
            },
            "required": ["label", "value"]
          }
        },
        "selected": {"type": "string"},
        "attributes": {
          "type": "object",
          "properties": {
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component", "options"]
    },
    "SelectDropdown": {
      "description": "Searchable dropdown select",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "SelectDropdown"},
        "label": {"type": "string"},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {"type": "string"},
              "value": {"type": "string"}
            },
            "required": ["label", "value"]
          }
        },
        "selected": {"type": "string"},
        "searchable": {"type": "boolean"},
        "attributes": {
          "type": "object",
          "properties": {
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component", "options"]
    },
    "List": {
      "description": "Scrollable selectable list",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "List"},
        "label": {"type": "string"},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "label": {"type": "string"},
              "description": {"type": "string"},
              "avatar": {"type": "string"}
            },
            "required": ["id", "label"]
          }
        },
        "selected": {"type": "string"},
        "attributes": {
          "type": "object",
          "properties": {
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component", "items"]
    },
    "Image": {
      "description": "Image from URL or base64",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Image"},
        "source": {
          "type": "object",
          "properties": {
            "type": {"enum": ["url", "base64"]},
            "url": {"type": "string"},
            "data": {"type": "string"}
          },
          "required": ["type"]
        },
        "size": {"enum": ["small", "medium", "large"]},
        "alt": {"type": "string"},
        "attributes": {
          "type": "object",
          "properties": {
            "disabled": {"type": "boolean"}
          }
        }
      },
      "required": ["id", "component", "source"]
    },
    "Card": {
      "description": "Container for grouped content",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Card"},
        "children": {
          "type": "array",
          "items": {"type": "string"}
        },
        "attributes": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "elevation": {"type": "number"}
          }
        }
      },
      "required": ["id", "component"]
    },
    "Column": {
      "description": "Vertical layout container",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Column"},
        "children": {
          "type": "array",
          "items": {"type": "string"}
        },
        "attributes": {
          "type": "object",
          "properties": {
            "spacing": {"type": "number"},
            "mainAxisAlignment": {"enum": ["start", "center", "end", "spaceBetween"]}
          }
        }
      },
      "required": ["id", "component"]
    },
    "Row": {
      "description": "Horizontal layout container",
      "properties": {
        "id": {"type": "string"},
        "component": {"const": "Row"},
        "children": {
          "type": "array",
          "items": {"type": "string"}
        },
        "attributes": {
          "type": "object",
          "properties": {
            "spacing": {"type": "number"},
            "mainAxisAlignment": {"enum": ["start", "center", "end", "spaceBetween"]}
          }
        }
      },
      "required": ["id", "component"]
    }
  },
  "messageTypes": {
    "createSurface": {
      "description": "Initialize a UI surface",
      "properties": {
        "version": {"const": "v0.9"},
        "createSurface": {
          "type": "object",
          "properties": {
            "surfaceId": {"type": "string"},
            "catalogId": {"type": "string"}
          },
          "required": ["surfaceId"]
        }
      },
      "required": ["version", "createSurface"]
    },
    "updateComponents": {
      "description": "Send or update component definitions",
      "properties": {
        "version": {"const": "v0.9"},
        "updateComponents": {
          "type": "object",
          "properties": {
            "surfaceId": {"type": "string"},
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {"type": "string"},
                  "component": {"type": "string", "enum": ["Text", "Button", "TextField", "Checkbox", "RadioGroup", "SelectDropdown", "List", "Image", "Card", "Column", "Row"]}
                },
                "required": ["id", "component"]
              }
            }
          },
          "required": ["surfaceId", "components"]
        }
      },
      "required": ["version", "updateComponents"]
    },
    "updateDataModel": {
      "description": "Populate or update bound data",
      "properties": {
        "version": {"const": "v0.9"},
        "updateDataModel": {
          "type": "object",
          "properties": {
            "surfaceId": {"type": "string"},
            "path": {"type": "string"},
            "value": {}
          },
          "required": ["surfaceId", "path", "value"]
        }
      },
      "required": ["version", "updateDataModel"]
    },
    "deleteSurface": {
      "description": "Remove a surface",
      "properties": {
        "version": {"const": "v0.9"},
        "deleteSurface": {
          "type": "object",
          "properties": {
            "surfaceId": {"type": "string"}
          },
          "required": ["surfaceId"]
        }
      },
      "required": ["version", "deleteSurface"]
    }
  },
  "rules": {
    "componentIds": "All component IDs must be unique within a surface",
    "childReferences": "Component children must reference component IDs, not inline objects",
    "surfaceInitialization": "Each surface must start with a createSurface message",
    "dataBinding": "Data paths use JSON path notation like /form/fieldName",
    "noCodeExecution": "A2UI is declarative only — agents cannot execute arbitrary code"
  }
}
